+// FLAGHIT instrumentation (temporary, never commit)
+#[doc(hidden)]
+#[allow(missing_docs, clippy::all)]
+pub fn __flaghit(name: &'static str) -> bool {
+    use std::collections::BTreeSet;
+    use std::sync::{Mutex, OnceLock};
+    static SEEN: OnceLock<Mutex<BTreeSet<(String, &'static str)>>> = OnceLock::new();
+    static OFF: OnceLock<Option<String>> = OnceLock::new();
+    let forced = OFF.get_or_init(|| std::env::var("FLAGHIT_FORCE_OFF").ok()).as_deref() == Some(name);
+    let t = std::thread::current().name().unwrap_or("?").to_string();
+    static TAG: OnceLock<String> = OnceLock::new();
+    let tag = TAG.get_or_init(|| std::env::var("FLAGHIT_TAG").unwrap_or_default());
+    let key = format!("{tag}|{t}");
+    let m = SEEN.get_or_init(|| Mutex::new(BTreeSet::new()));
+    let new = match m.lock() { Ok(mut s) => s.insert((key, name)), Err(e) => e.into_inner().insert((format!("{tag}|{t}"), name)) };
+    if new {
+        if let Ok(p) = std::env::var("FLAGHIT_LOG") {
+            use std::io::Write;
+            let exe = std::env::current_exe().ok().and_then(|e| e.file_name().map(|s| s.to_string_lossy().into_owned())).unwrap_or_default();
+            if let Ok(mut f) = std::fs::OpenOptions::new().create(true).append(true).open(p) {
+                let _ = writeln!(f, "{name}\t{exe}\t{tag}\t{t}");
+            }
+        }
+    }
+    forced
+}
